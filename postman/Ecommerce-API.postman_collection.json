{
  "info": {
    "name": "Ecommerce API (Production)",
    "description": "Postman collection for ecommerce-api.\n\nBase URL: https://mgt.luckkabarnh3.com\n\n1. Run Auth → Login (or OTP register flow)\n2. Copy `access_token` from the response into the collection variable `access_token`\n3. Authenticated requests use Bearer {{access_token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://mgt.luckkabarnh3.com"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth / Users",
      "item": [
        {
          "name": "OTP Request (Register)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"0912345678\"\n}"
            },
            "url": "{{baseUrl}}/api/otp-request"
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"\",\n  \"otp_code\": \"\",\n  \"name\": \"Test User\",\n  \"phone_number\": \"0912345678\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "  }",
                  "  if (json.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "  }",
                  "  if (json.data && json.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.data.access_token);",
                  "  }",
                  "  if (json.data && json.data.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
                  "  }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"0912345678\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{baseUrl}}/api/refresh-token"
          }
        },
        {
          "name": "OTP Reset Request",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"0912345678\"\n}"
            },
            "url": "{{baseUrl}}/api/otp-reset"
          }
        },
        {
          "name": "Reset Password (OTP Verify)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"\",\n  \"otp_code\": \"\",\n  \"phone_number\": \"0912345678\"\n}"
            },
            "url": "{{baseUrl}}/api/reset"
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/verify"
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/update"
          }
        },
        {
          "name": "List Users",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Set User Percentage",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"percentage\": 10\n}"
            },
            "url": "{{baseUrl}}/api/users/1/percentage"
          }
        },
        {
          "name": "Restore User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users/1/restore"
          }
        },
        {
          "name": "Revoke User Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/1/refresh-token"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/1"
          }
        }
      ]
    },
